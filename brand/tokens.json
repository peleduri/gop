    "live": {"color": "ev-live", "dash": "none", "glyph": "✓", "label": "live"},
    "inferred": {"color": "ev-inferred", "dash": "10 3", "glyph": "≈", "label": "inferred"},
    "audit": {"color": "ev-audit", "dash": "6 4", "glyph": "↺", "label": "audit"},
    "supplied": {"color": "ev-supplied", "dash": "12 3 2 3", "glyph": "≡", "label": "supplied"},
    "not_visible": {"color": "ev-not-visible", "dash": "2 4", "glyph": "?", "label": "not visible"}
  },
  "reach": {
    "confirmed": {"color": "accent", "dash": "none", "width": "2.5", "glyph": "✓"},
    "possible": {"color": "possible", "dash": "6 4", "width": "2", "glyph": "?"},
    "danger": {"color": "danger", "dash": "none", "width": "3", "glyph": "▲"},
    "cut": {"color": "ok", "dash": "none", "width": "2", "glyph": "✕"}
  },
  "nodes": {
    "enterprise": {"shape": "hexagon", "color": "fg"},
    "org": {"shape": "tab", "color": "fg"},
    "org_members": {"shape": "double-circle", "color": "fg"},
    "identity": {"shape": "circle", "color": "fg"},
    "external": {"shape": "ringed-circle", "color": "danger"},
    "repo": {"shape": "rounded-rect", "color": "muted"},
    "workflow": {"shape": "diamond", "color": "muted"},
    "agent": {"shape": "diamond-dot", "color": "accent"},
    "action_ref": {"shape": "hollow-diamond", "color": "muted"},
    "secret": {"shape": "square", "color": "target"},
    "oidc": {"shape": "shield", "color": "target"},
    "cloud_target": {"shape": "stadium", "color": "target"},
    "runner": {"shape": "barred-square", "color": "target"}
